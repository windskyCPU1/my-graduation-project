  <!-- 传感器插件（需确保 $(find robot2)/urdf/gazebo_sensor_plugin.xacro 存在） -->
  <xacro:include filename="$(find robot2)/urdf/gazebo_sensor_plugin.xacro" />
  <xacro:gazebo_sensor_plugin name="robot2" />
</robot>